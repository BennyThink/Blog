# Copy or generate .env; never commit the real key.
EMDASH_ENCRYPTION_KEY=
EMDASH_PORT=4321
EMDASH_SITE_URL=http://localhost:4321

# Theme notification credentials stay on the server. Enable after migration in plugin settings.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Exact raw IP addresses, comma-separated; use the real peer address from the adapter.
COMMENT_BLOCKED_IPS=
# Optional database override for isolated previews.
# EMDASH_DATABASE_URL=file:/tmp/emdash-theme-preview.db
