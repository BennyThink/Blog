{
  "name": "dmesg",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "emdash": {
    "label": "Blog",
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "export:legacy": "node scripts/export-legacy.mjs",
    "preview": "astro preview",
    "start": "node ./scripts/start.mjs",
    "typecheck": "astro check",
    "secrets:init": "emdash secrets generate --write .env",
    "migrate:v-notice": "node scripts/migrate-wp-shortcodes.mjs",
    "migrate:wp-callouts": "node scripts/migrate-wp-shortcodes.mjs",
    "migrate:wp-shortcodes": "node scripts/migrate-wp-shortcodes.mjs",
    "verify:docker": "node scripts/verify-docker.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "^7.0.0",
    "@emdash-cms/auth": "1.6.0",
    "astro": "^7.3.2",
    "emdash": "1.6.0",
    "entities": "6.0.1",
    "ip2region.js": "^3.1.8",
    "parse5": "^8.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "lightningcss": "^1.33.0"
  },
  "overrides": {
    "@emdash-cms/gutenberg-to-portable-text": {
      "parse5": "$parse5"
    }
  }
}
