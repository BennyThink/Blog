---
import { getEmDashCollection, getSiteSettingsWithCacheHint } from "emdash";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import ThemeSidebar from "../components/ThemeSidebar.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
const [result, settings] = await Promise.all([
  getEmDashCollection("posts", { orderBy: { published_at: "desc" }, limit: 10 }),
  getSiteSettingsWithCacheHint(),
]);
if (Astro.cache?.enabled) { Astro.cache.set(result.cacheHint); Astro.cache.set(settings.cacheHint); }
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings.data);
---
<Base title={siteTitle} description={siteTagline}>
  <section class="band section theme-home">
    <div class="frame theme-home__layout">
      <div>
        <h1 class="sr-only">{siteTitle} · 最新文章</h1>
        <div class="theme-post-list">
          {result.entries.map((post, index) => <PostCard post={post} tags={post.data.terms?.tag ?? []} variant="row" headingLevel={2} priority={index === 0} />)}
          {result.entries.length === 0 && <p class="empty-state">暂无文章。</p>}
        </div>
        {result.nextCursor && <a class="btn theme-more" href={`/posts?cursor=${encodeURIComponent(result.nextCursor)}`}>更早的文章</a>}
        <a class="theme-all-posts" href="/posts">全部文章</a>
      </div>
      <ThemeSidebar />
    </div>
  </section>
</Base>
