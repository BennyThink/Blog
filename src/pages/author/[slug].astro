---
import { decodeSlug, getBylineBySlug, getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import Pagination from "../../components/Pagination.astro";
import ThemePostList from "../../components/ThemePostList.astro";

const slug = decodeSlug(Astro.params.slug);
const author = slug ? await getBylineBySlug(slug) : null;
if (!author) return Astro.rewrite("/404");

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const { entries, nextCursor, cacheHint, error } = await getEmDashCollection("posts", {
  status: "published",
  where: { byline: author.translationGroup ?? author.id },
  orderBy: { published_at: "desc" },
  limit: 20,
  cursor,
});
if (error) throw error;
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const title = `${author.displayName} 的文章`;
const basePath = `/author/${encodeURIComponent(author.slug)}`;
---

<Base title={title}>
  <header class="band intro">
    <div class="frame">
      <h1 class="intro__title">{title}</h1>
      {author.bio && <p class="intro__lead">{author.bio}</p>}
    </div>
  </header>
  <ThemePostList posts={entries}>
    <p slot="empty">{cursor ? "没有更多文章了。" : "这位作者暂时没有已发布的文章。"}</p>
    <Pagination slot="pagination" basePath={basePath} cursor={cursor} nextCursor={nextCursor} />
  </ThemePostList>
</Base>
