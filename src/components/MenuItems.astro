---
interface Item { id: string; label: string; url: string; target?: string; children?: Item[]; }
interface Props { items: Item[]; currentPath: string; }
const { items, currentPath } = Astro.props;
const labels: Record<string, string> = { Home: "首页", About: "关于", Posts: "文章" };
function current(url: string) {
  try { const u = new URL(url, Astro.url); return u.origin === Astro.url.origin && u.pathname.replace(/\/$/, "") === currentPath.replace(/\/$/, "") && !u.hash && (!u.search || u.search === Astro.url.search) ? "page" as const : undefined; }
  catch { return undefined; }
}
function safeUrl(url: string) {
  try { return ["http:", "https:", "mailto:"].includes(new URL(url, Astro.url).protocol) ? url : "#"; }
  catch { return "#"; }
}
---
{items.map(item => <li class="theme-menu-item">
  {item.children?.length ? <details class="theme-submenu">
    <summary>{labels[item.label] ?? item.label}</summary>
    <ul><li><a href={safeUrl(item.url)}>{labels[item.label] ?? item.label}</a></li><Astro.self items={item.children} currentPath={currentPath} /></ul>
  </details> : <a href={safeUrl(item.url)} target={item.target} rel={item.target === "_blank" ? "noopener noreferrer" : undefined} aria-current={current(item.url)}>{labels[item.label] ?? item.label}</a>}
</li>)}
