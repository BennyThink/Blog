---
interface Props {
	comment: {
		id: string;
		author_name: string;
		author_user_id: string | null;
		body: string;
		created_at: string | null;
	};
}

const { comment } = Astro.props;
const date = comment.created_at ? new Date(comment.created_at) : null;
const dateText = date && !Number.isNaN(date.getTime())
	? new Intl.DateTimeFormat("zh-CN", { dateStyle: "medium", timeStyle: "short", timeZone: "Asia/Shanghai" }).format(date)
	: null;
const parts = comment.body.split(/(https?:\/\/[^\s<>"')\]]+)/g);
---

<article class="ec-comment" id={`comment-${comment.id}`} data-comment-id={comment.id}>
	<header class="ec-comment-header">
		<span class="ec-comment-author">{comment.author_name}</span>
		{comment.author_user_id && <span class="ec-comment-badge" aria-label="站点成员">✓</span>}
		{dateText && <time class="ec-comment-date" datetime={date?.toISOString()}>{dateText}</time>}
	</header>
	<div class="ec-comment-body">{parts.map((part, index) => index % 2
		? <a href={part} rel="nofollow ugc noopener" target="_blank">{part}</a>
		: part)}</div>
	<slot />
</article>
