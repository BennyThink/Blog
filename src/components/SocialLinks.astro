---
import { getThemeSettings, safeSocialUrl } from "../theme/settings";
const settings = await getThemeSettings(Astro.locals, Astro.request);
const links = [
  { label: "Telegram 频道", url: safeSocialUrl(settings.telegramChannel) },
  { label: "Email", url: /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(settings.email) ? `mailto:${settings.email}` : undefined },
  { label: "GitHub", url: safeSocialUrl(settings.github) },
  { label: "Twitter", url: safeSocialUrl(settings.twitter) },
  { label: "Telegram", url: /^[a-zA-Z0-9_]{5,32}$/.test(settings.telegram.replace(/^@/, "")) ? `https://t.me/${settings.telegram.replace(/^@/, "")}` : undefined },
].filter(link => link.url);
---
{links.length > 0 && <nav class="theme-social" aria-label="社交链接">{links.map(link => <a href={link.url} rel="me noopener noreferrer" target="_blank">{link.label}</a>)}</nav>}
