---
import { getEmDashCollection, getTaxonomyTermsWithCacheHint } from "emdash";
import SocialLinks from "./SocialLinks.astro";

const [recent, categories] = await Promise.all([
  getEmDashCollection("posts", { orderBy: { published_at: "desc" }, limit: 5 }),
  getTaxonomyTermsWithCacheHint("category", { includeCounts: true }),
]);
if (Astro.cache?.enabled) {
  Astro.cache.set(recent.cacheHint);
  Astro.cache.set(categories.cacheHint);
}

const allPosts = await getEmDashCollection("posts", { orderBy: { published_at: "desc" }, limit: 1000 });
const postCount = allPosts.entries.length;
const totalViews = allPosts.entries.reduce((sum, entry) => sum + (typeof entry.data.views === "number" ? entry.data.views : 0), 0);
const firstPublished = allPosts.entries.reduce<Date | null>((earliest, entry) => {
  const publishedAt = entry.data.publishedAt ? new Date(entry.data.publishedAt) : null;
  return publishedAt && (!earliest || publishedAt < earliest) ? publishedAt : earliest;
}, null);
const loggedIn = Boolean(Astro.locals.user);
const date = new Date();
const day = new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate()));
const runningDays = firstPublished ? Math.max(1, Math.floor((day.getTime() - Date.UTC(firstPublished.getUTCFullYear(), firstPublished.getUTCMonth(), firstPublished.getUTCDate())) / 86_400_000)) : 0;
---
<aside class="theme-sidebar" aria-label="博客侧栏">
  <section class="sidebar-panel sidebar-recommendations">
    <h2>你可能喜欢</h2>
    {recent.entries.length > 0 ? <ol>{recent.entries.map(post => <li><a href={`/${post.id}.html`}>{post.data.title}</a></li>)}</ol> : <p class="sidebar-empty">还没有文章。</p>}
  </section>

  <section class="sidebar-panel">
    <h2>文章分类</h2>
    {categories.data.length > 0 ? <ul class="sidebar-categories">{categories.data.map(term => <li><a href={`/category/${term.slug}`}>{term.label}</a><span>{term.count ?? 0}</span></li>)}</ul> : <p class="sidebar-empty">暂无分类。</p>}
  </section>

  <section class="sidebar-panel sidebar-stats">
    <h2>网站统计</h2>
    <dl>
      <div><dt>文章</dt><dd>{postCount}</dd></div>
      <div><dt>分类</dt><dd>{categories.data.length}</dd></div>
      <div><dt>浏览</dt><dd>{totalViews}</dd></div>
      <div><dt>建站</dt><dd>{runningDays} 天</dd></div>
    </dl>
  </section>

  <section class="sidebar-panel sidebar-owner">
    <h2>主人我在这 (=￣ω￣=)</h2>
    <p>{loggedIn ? "欢迎回来，主人。" : "欢迎来访，随便看看吧。"}</p>
    <a class="sidebar-owner__login" href="/_emdash/admin">{loggedIn ? "进入站长后台" : "站长登录"}</a>
    <a href="/rss.xml">订阅文章 RSS</a>
    <SocialLinks />
  </section>
</aside>
